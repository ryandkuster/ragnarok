manifest {
    name        = 'ragnarok'
    description = 'A nextflow-implemented pipeline for rapid genome annotation using multiple lines of evidence'
    homePage    = 'https://github.com/ryandkuster/ragnarok'
    license     = 'MIT'
}

params {
    run_timestamp = new java.text.SimpleDateFormat('yyyyMMdd_HHmmss').format(new Date())

    skip_qc            = true
    skip_trim          = true
    minimum_length     = 50
    mask_threshold     = false

    // legacy: --perform_masking false disables all mask_* params
    perform_masking    = true
    mask_tool          = params.perform_masking ? "edta" : ""
    mask_helixer       = params.perform_masking ? true  : false
    mask_rna           = params.perform_masking ? true  : false
    mask_protein       = params.perform_masking ? true  : false

    skip_st            = false
    skip_hx            = false
    nlrs               = false
    ill                = false
    pb                 = false
    ont                = false
    lineage            = "https://zenodo.org/records/10836346/files/land_plant_v0.3_a_0080.h5"
    subseq_len         = 64152
    lo_genome          = false
    lo_gff             = false
    busco_db           = "embryophyta_odb12"
    final_prefix       = "ragnarok"
    max_intron         = 10000
    entap_conf         = "${projectDir}/assets/template_entap_config.ini"
    entap_run          = "${projectDir}/assets/template_entap_run.params"
    entap_db           = false
    genome_masked      = false
}

includeConfig "conf/containers.config"

profiles {
    slurm {
        includeConfig "conf/slurm.config"
        workDir = "${params.publish_dir}/work/"

        executor {
            queueSize = 50
            submitRateLimit = '10/1min'
        }

        singularity {
            enabled = true
            cacheDir = "${System.getenv('SCRATCHDIR')}/singularity/"
            autoMounts = true
            pullTimeout = "3h"
        }

        process {
            executor = 'slurm'
        }
        includeConfig "conf/reporting.config"
    }

    local {
        // create default for publish_dir if not input
        includeConfig "conf/local.config"
        workDir = "${params.publish_dir}/work/"

        singularity {
            enabled = true
            cacheDir = "${System.getenv('SCRATCHDIR')}/singularity/"
            autoMounts = true
            pullTimeout = "3h"
        }

        includeConfig "conf/reporting.config"
    }

}
