dag {
    enabled = true
    file    = "${params.publish_dir}/publish/summary/${params.run_timestamp}_dag.html"
    overwrite = true
}

report {
    enabled = true
    file    = "${params.publish_dir}/publish/summary/${params.run_timestamp}_report.html"
    overwrite = true
}

timeline{
    enabled = true
    file    = "${params.publish_dir}/publish/summary/${params.run_timestamp}_timeline.html"
    overwrite = true
}

trace {
    enabled = true
    file    = "${params.publish_dir}/publish/summary/${params.run_timestamp}_trace.html"
    overwrite = true
}
